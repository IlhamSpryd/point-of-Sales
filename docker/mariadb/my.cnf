# ==============================================================================
# Apeiron POS — MariaDB 11.4 Production Configuration
# Ensures deterministic trigger execution and high concurrency
# ==============================================================================

[mysqld]
# Enterprise Trigger & Stored Function Execution (Mandatory for GL & Stock Triggers)
log_bin_trust_function_creators = 1

# Character Set & Collation (Indonesian & Global UTF-8 Support)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Strict SQL Mode (Financial & Data Integrity)
sql_mode = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"

# Connection & Timeout Settings
max_connections = 250
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 64M

# InnoDB Engine Tuning
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_log_buffer_size = 16M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

