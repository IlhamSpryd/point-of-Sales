<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="false"
         failOnNotice="false"
         failOnWarning="false"
>
    <testsuites>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integrity">
            <directory>tests/Feature/Tenancy</directory>
            <directory>tests/Feature/Finance</directory>
            <directory>tests/Feature/Subscription</directory>
            <directory>tests/Feature/Workflow</directory>
            <directory>tests/Feature/Navigation</directory>
            <directory>tests/Feature/Kasir</directory>
            <directory>tests/Feature/Retail</directory>
            <directory>tests/Feature/Manufacturing</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Tenancy</exclude>
            <exclude>tests/Feature/Finance</exclude>
            <exclude>tests/Feature/Subscription</exclude>
            <exclude>tests/Feature/Workflow</exclude>
            <exclude>tests/Feature/Navigation</exclude>
            <exclude>tests/Feature/Kasir</exclude>
            <exclude>tests/Feature/Retail</exclude>
            <exclude>tests/Feature/Manufacturing</exclude>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>chaos</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="1024M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="yovel_pos_test" force="true"/>
        <env name="DB_USERNAME" value="laravel_pos" force="true"/>
        <env name="DB_PASSWORD" value="${DB_PASSWORD}"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="TRUSTED_PROXIES" value="127.0.0.1"/>
    </php>
</phpunit>
